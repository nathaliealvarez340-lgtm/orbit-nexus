# SAT resources whose SHA-256 is recorded in src/lib/sat/catcfdi/manifest.json.
# Git must never convert their line endings: every checkout (Windows or not) has to
# reproduce the exact bytes the manifest verifies.

# Official SAT files, stored byte-for-byte as published (catCFDI.xsd uses CRLF).
resources/sat/** binary

# Generated by scripts/sat/build-catcfdi.mjs, which always writes LF.
src/lib/sat/catcfdi/*.json -text

# Prisma records the SHA-256 of each migration.sql as its checksum. The Fase 5C.3
# migration is stored and applied with the exact bytes of its Git blob (LF, ASCII):
# never convert its line endings on checkout. Historical migrations stay unchanged until
# their checksums are compared with the ones recorded in Neon.
prisma/migrations/202610110001_phase5c3_csd_custody/migration.sql -text

# Fase 5C.4: generated by scripts/sat/build-cfdi40-resources.mjs (LF), hash-checked in tests.
src/lib/sat/cfdi40/*.json -text
# Reference unsigned CFDI XML: compared byte for byte (single line, no trailing newline).
tests/fixtures/cfdi40/*.xml -text
# Fase 5C.5: cadena original fixtures (CFDI XML and expected cadenas) are compared byte for byte.
tests/fixtures/cfdi40/cadena/** -text
