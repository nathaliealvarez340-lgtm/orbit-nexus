# Configuración de servidor. Copia a .env y completa valores propios.
# Nunca uses NEXT_PUBLIC_ para credenciales. Este archivo no contiene secretos reales.
DATABASE_URL=""
# Origen exacto, sin /api/auth. En Vercel: HTTPS y dominio del despliegue.
# Local: http://localhost:3000. Producción no admite fallback a localhost.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Opcionales. Vacíos: revisión manual y recuperación por correo no disponible.
OCR_API_URL=""
OCR_API_TOKEN=""
MAIL_API_URL=""
MAIL_API_TOKEN=""

# Facturación de tickets: worker externo de confianza; vacío mantiene flujo manual.
# HTTPS en producción. Contrato y requisitos: docs/phase4-ticket-billing.md
BILLING_AUTOMATION_URL=""
BILLING_AUTOMATION_TOKEN=""
# IDs de adapters revisados e instalados en el worker, separados por comas.
# No activa automáticamente OXXO/Walmart/Costco ni proveedores personalizados.
BILLING_AUTOMATION_ADAPTERS=""
