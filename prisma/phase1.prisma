generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  INDIVIDUAL
  COMPANY
}

enum TicketStatus {
  UPLOADED
  ANALYZING
  READY
  INVOICED
  ERROR
}

enum InvoiceStatus {
  DRAFT
  READY
  ISSUED
  CANCELLED
  ERROR
}

enum CompatibilityLevel {
  AUTOMATIC
  ASSISTED
  PLANNED
}

model User {
  id              String                   @id @default(cuid())
  name            String
  email           String                   @unique
  passwordHash    String
  type            UserType                 @default(INDIVIDUAL)
  fiscalProfile   FiscalProfile?
  fiscalDocuments UploadedFiscalDocument[]
  tickets         Ticket[]
  invoices        Invoice[]
  stampedInvoices StampedInvoice[]
  activityLogs    ActivityLog[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model FiscalProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfc          String    @unique
  legalName    String
  fiscalRegime String
  postalCode   String
  cfdiUse      String
  email        String
  phone        String?
  address      String?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UploadedFiscalDocument {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  storageKey    String
  mimeType      String
  extractedData Json?
  isConfirmed   Boolean   @default(false)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Ticket {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?             @relation(fields: [companyId], references: [id])
  fileName      String
  storageKey    String
  mimeType      String
  status        TicketStatus         @default(UPLOADED)
  total         Decimal?             @db.Decimal(12, 2)
  purchaseDate  DateTime?
  extractedData TicketExtractedData?
  invoice       Invoice?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, status])
  @@index([companyId])
}

model TicketExtractedData {
  id         String   @id @default(cuid())
  ticketId   String   @unique
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  provider   String
  confidence Float
  fields     Json
  rawResult  Json?
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId    String?          @unique
  ticket      Ticket?          @relation(fields: [ticketId], references: [id])
  providerId  String?
  provider    InvoiceProvider? @relation(fields: [providerId], references: [id])
  status      InvoiceStatus    @default(DRAFT)
  receiverRfc String
  subtotal    Decimal          @db.Decimal(12, 2)
  tax         Decimal          @db.Decimal(12, 2)
  total       Decimal          @db.Decimal(12, 2)
  externalId  String?
  xmlUrl      String?
  pdfUrl      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model InvoiceProvider {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(false)
  config    Json?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Company {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  portalUrl      String
  compatibility  CompatibilityLevel
  requiredFields Json
  rules          Json
  tickets        Ticket[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model StampedInvoice {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  uuid        String?                 @unique
  status      InvoiceStatus           @default(DRAFT)
  issuerRfc   String
  receiverRfc String
  subtotal    Decimal                 @db.Decimal(12, 2)
  tax         Decimal                 @db.Decimal(12, 2)
  total       Decimal                 @db.Decimal(12, 2)
  concepts    StampedInvoiceConcept[]
  xmlUrl      String?
  pdfUrl      String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model StampedInvoiceConcept {
  id               String         @id @default(cuid())
  stampedInvoiceId String
  stampedInvoice   StampedInvoice @relation(fields: [stampedInvoiceId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal        @db.Decimal(12, 4)
  unitPrice        Decimal        @db.Decimal(12, 2)
  taxRate          Decimal        @db.Decimal(5, 4)
  total            Decimal        @db.Decimal(12, 2)
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
