generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  INDIVIDUAL
  COMPANY
}

enum TicketStatus {
  UPLOADED
  ANALYZING
  READY
  INVOICED
  ERROR
  REVIEW
  REGISTERED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum BillingStatus {
  NOT_REQUESTED
  READY
  REQUIRES_DATA
  REDIRECT_REQUIRED
  PROCESSING
  INVOICED
  FAILED
}

model Organization {
  id              String                   @id @default(cuid())
  name            String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships     Membership[]
  fiscalProfile   FiscalProfile?
  fiscalDocuments UploadedFiscalDocument[]
  tickets         Ticket[]
  expenses        Expense[]
  invoices        Invoice[]
  stampedInvoices StampedInvoice[]
  activityLogs    ActivityLog[]
  documents       Document[]
  subscription    Subscription?
  clients         Client[]
  invoiceSettings InvoiceSettings?
  reports         MonthlyExpenseReport[]
  notifications   Notification[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model RequestLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Document {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById    String
  fileName        String
  mimeType        String
  size            Int
  sha256          String
  content         Bytes
  kind            String
  createdAt       DateTime                 @default(now())
  tickets         Ticket[]
  fiscalDocuments UploadedFiscalDocument[]
  xmlInvoices     Invoice[]                @relation("InvoiceXml")
  pdfInvoices     Invoice[]                @relation("InvoicePdf")
  csfProfiles     FiscalProfile[]          @relation("FiscalCsf")
  invoiceSettings InvoiceSettings[]        @relation("InvoiceLogo")
  outgoingXml     StampedInvoice[]         @relation("OutgoingXml")
  outgoingPdf     StampedInvoice[]         @relation("OutgoingPdf")

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId       String        @unique
  ticket         Ticket        @relation(fields: [organizationId, ticketId], references: [organizationId, id])
  capturedById   String
  merchant       String
  purchaseDate   DateTime      @db.Date
  total          Decimal       @db.Decimal(12, 2)
  subtotal       Decimal?      @db.Decimal(12, 2)
  tax            Decimal?      @db.Decimal(12, 2)
  category       String?
  folio          String?
  details        Json?
  billingStatus  BillingStatus @default(NOT_REQUESTED)
  confirmedAt    DateTime      @default(now())

  @@unique([organizationId, ticketId])
  @@unique([organizationId, id])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, billingStatus])
}

enum InvoiceStatus {
  DRAFT
  READY
  ISSUED
  CANCELLED
  ERROR
}

enum CompatibilityLevel {
  AUTOMATIC
  ASSISTED
  PLANNED
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  passwordHash      String?
  preference        UserPreference?
  notificationReads NotificationRead[]
  emailVerified     Boolean                  @default(false)
  image             String?
  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]
  type              UserType                 @default(INDIVIDUAL)
  fiscalProfiles    FiscalProfile[]
  fiscalDocuments   UploadedFiscalDocument[]
  tickets           Ticket[]
  invoices          Invoice[]
  stampedInvoices   StampedInvoice[]
  activityLogs      ActivityLog[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model FiscalProfile {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personType     UserType     @default(COMPANY)
  rfc            String
  legalName      String
  fiscalRegime   String
  postalCode     String
  cfdiUse        String
  email          String
  phone          String?
  address        String?
  street         String?
  exteriorNumber String?
  interiorNumber String?
  colony         String?
  locality       String?
  municipality   String?
  state          String?
  country        String       @default("MEX")
  csfDocumentId  String?
  csfDocument    Document?    @relation("FiscalCsf", fields: [organizationId, csfDocumentId], references: [organizationId, id])
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UploadedFiscalDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?    @relation(fields: [organizationId, documentId], references: [organizationId, id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  extractedData  Json?
  isConfirmed    Boolean      @default(false)
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model Ticket {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?            @relation(fields: [organizationId, documentId], references: [organizationId, id])
  expense        Expense?
  billingStatus  BillingStatus        @default(NOT_REQUESTED)
  merchant       String?
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?             @relation(fields: [companyId], references: [id])
  fileName       String
  storageKey     String
  mimeType       String
  status         TicketStatus         @default(UPLOADED)
  total          Decimal?             @db.Decimal(12, 2)
  purchaseDate   DateTime?
  extractedData  TicketExtractedData?
  invoice        Invoice?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, id])
  @@index([userId, status])
  @@index([companyId])
  @@index([organizationId, createdAt])
}

model TicketExtractedData {
  id             String   @id @default(cuid())
  ticketId       String   @unique
  organizationId String
  ticket         Ticket   @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Cascade)
  provider       String
  confidence     Float?
  fields         Json
  rawResult      Json?
  createdAt      DateTime @default(now())

  @@unique([organizationId, ticketId])
}

model Invoice {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uuid           String?
  issuerName     String?
  issuedAt       DateTime?
  xmlDocumentId  String?
  pdfDocumentId  String?
  xmlDocument    Document?        @relation("InvoiceXml", fields: [organizationId, xmlDocumentId], references: [organizationId, id])
  pdfDocument    Document?        @relation("InvoicePdf", fields: [organizationId, pdfDocumentId], references: [organizationId, id])
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId       String?          @unique
  ticket         Ticket?          @relation(fields: [organizationId, ticketId], references: [organizationId, id])
  providerId     String?
  provider       InvoiceProvider? @relation(fields: [providerId], references: [id])
  status         InvoiceStatus    @default(DRAFT)
  receiverRfc    String
  subtotal       Decimal          @db.Decimal(12, 2)
  tax            Decimal          @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  externalId     String?
  xmlUrl         String?
  pdfUrl         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, ticketId])
  @@unique([organizationId, uuid])
  @@index([organizationId, createdAt])
}

model InvoiceProvider {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(false)
  config    Json?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Company {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  portalUrl      String
  compatibility  CompatibilityLevel
  requiredFields Json
  rules          Json
  tickets        Ticket[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model StampedInvoice {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  uuid             String?                 @unique
  status           InvoiceStatus           @default(DRAFT)
  clientId         String?
  client           Client?                 @relation(fields: [organizationId, clientId], references: [organizationId, id])
  folio            String?
  sequence         Int?
  invoiceDate      DateTime?               @db.Date
  issuedAt         DateTime?
  currency         String                  @default("MXN")
  documentType     String                  @default("I")
  cfdiUse          String?
  paymentForm      String?
  paymentMethod    String?
  issuerSnapshot   Json?
  receiverSnapshot Json?
  templateSnapshot Json?
  xmlDocumentId    String?
  pdfDocumentId    String?
  xmlDocument      Document?               @relation("OutgoingXml", fields: [organizationId, xmlDocumentId], references: [organizationId, id])
  pdfDocument      Document?               @relation("OutgoingPdf", fields: [organizationId, pdfDocumentId], references: [organizationId, id])
  issuerRfc        String
  receiverRfc      String
  subtotal         Decimal                 @db.Decimal(12, 2)
  tax              Decimal                 @db.Decimal(12, 2)
  total            Decimal                 @db.Decimal(12, 2)
  concepts         StampedInvoiceConcept[]
  xmlUrl           String?
  pdfUrl           String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, folio])
  @@index([organizationId, issuedAt])
}

model StampedInvoiceConcept {
  id               String         @id @default(cuid())
  stampedInvoiceId String
  stampedInvoice   StampedInvoice @relation(fields: [stampedInvoiceId], references: [id], onDelete: Cascade)
  description      String
  productCode      String         @default("01010101")
  unitCode         String         @default("ACT")
  quantity         Decimal        @db.Decimal(12, 4)
  unitPrice        Decimal        @db.Decimal(12, 2)
  taxRate          Decimal        @db.Decimal(5, 4)
  total            Decimal        @db.Decimal(12, 2)
}

enum SubscriptionPlan {
  FREE
  PRO
  MAX
}

enum AccentColor {
  PURPLE
  BLUE
  ORANGE
  RED
}

model Subscription {
  organizationId String           @id
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @default(FREE)
  updatedAt      DateTime         @updatedAt
}

model UserPreference {
  userId String      @id
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accent AccentColor @default(PURPLE)
}

model Client {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfc                String
  legalName          String
  personType         UserType         @default(COMPANY)
  internalNumber     String?
  foreignTaxId       String?
  fiscalRegime       String
  cfdiUse            String
  defaultPaymentForm String           @default("99")
  phone              String?
  email              String
  additionalEmails   String[]         @default([])
  notes              String?
  postalCode         String
  street             String?
  exteriorNumber     String?
  interiorNumber     String?
  colony             String?
  locality           String?
  municipality       String?
  state              String?
  country            String           @default("MEX")
  reference          String?
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  invoices           StampedInvoice[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
}

model InvoiceSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prefix         String       @default("ORB")
  nextNumber     Int          @default(1)
  color          String       @default("#8b5cf6")
  template       String       @default("CLASSIC")
  logoDocumentId String?
  logoDocument   Document?    @relation("InvoiceLogo", fields: [organizationId, logoDocumentId], references: [organizationId, id])
  updatedAt      DateTime     @updatedAt
}

model MonthlyExpenseReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  total          Decimal      @db.Decimal(16, 2)
  ticketCount    Int
  invoiceCount   Int
  pendingCount   Int
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, year, month])
  @@index([organizationId, createdAt])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventKey       String
  title          String
  message        String
  href           String
  type           String
  createdAt      DateTime           @default(now())
  reads          NotificationRead[]

  @@unique([organizationId, id])
  @@unique([organizationId, eventKey])
  @@index([organizationId, createdAt])
}

model NotificationRead {
  organizationId String
  notificationId String
  userId         String
  notification   Notification @relation(fields: [organizationId, notificationId], references: [organizationId, id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}
